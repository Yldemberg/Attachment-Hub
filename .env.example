# ============================================================
# Root .env.example — copy to .env and fill in real values.
# Variables marked [dev] are only needed in local development.
# Variables marked [prod] are only needed in production.
# Variables marked [both] are required in all environments.
#
# See also:
#   artifacts/api-server/.env.example  — backend-specific variables
#   artifacts/ihub/.env.example        — frontend-specific variables
# ============================================================

# --- Database (both) ---
# PostgreSQL connection string used by Drizzle ORM and the API connection pool.
# In Replit dev this is auto-provisioned; in prod point to Supabase postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/ihub

# --- Critical ads Supabase database (both) ---
# Connection string for the Supabase project that hosts ml_diagnostico_critico.
# On Replit, do NOT replace DATABASE_URL (used by the built-in Postgres for iHub core).
# Set this separate secret instead.
ML_DIAGNOSTICO_DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Supabase URL (both*) ---
# Supabase project URL. Used by the API server for JWKS JWT verification
# and by the frontend Supabase JS client for auth and data.
SUPABASE_URL=https://your-project.supabase.co

# --- Supabase JWT secret (both*) ---
# HS256 secret from Supabase > Project Settings > API > JWT Secret.
# When set on the API server, tokens are verified locally without a network call.
# * At least one of SUPABASE_URL or SUPABASE_JWT_SECRET must be set on the backend.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Mercado Livre OAuth (both) ---
# OAuth 2.0 credentials from Mercado Livre Developer Console.
ML_CLIENT_ID=your-ml-client-id
ML_CLIENT_SECRET=your-ml-client-secret
ML_REDIRECT_URI=https://ihub.example.com/api/mercadolivre/callback

# --- Amazon SP-API (private app) ---
# LWA credentials from Seller Central / Solution Provider Portal (production).
AMAZON_LWA_CLIENT_ID=your-amazon-lwa-client-id
AMAZON_LWA_CLIENT_SECRET=your-amazon-lwa-client-secret
AMAZON_REFRESH_TOKEN=Atzr|your-amazon-refresh-token
# Merchant / Selling Partner ID used in Listings Items paths (Seller Central).
AMAZON_SELLER_ID=AXXXXXXXXXXXX
# Brazil marketplace (default).
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC

# --- Mercado Livre webhook secret (both) ---
# Used to verify HMAC signatures on incoming ML webhook notifications.
ML_WEBHOOK_SECRET=your-ml-webhook-secret

# --- Stripe (both) ---
# API keys from Stripe Dashboard > Developers > API Keys.
# Use test keys (sk_test_…, whsec_…) in dev and live keys in prod.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# --- CORS (prod) ---
# Comma-separated list of allowed origins for the API server.
# When absent (local dev), CORS is open to all origins.
CORS_ALLOWED_ORIGINS=https://ihub.example.com

# --- Server port (dev) ---
# Port the API server listens on. Injected automatically by Replit.
PORT=8080

# --- Log level (both) ---
# Pino log level: trace | debug | info | warn | error | fatal. Defaults to "info".
LOG_LEVEL=info

# --- N8N listing creation (prepare only) ---
# Webhook URL to start async scraping/preparation from Amazon/Shopee links.
N8N_PREPARE_WEBHOOK_URL=https://n8n.odontflow.com.br/webhook/criar_anuncio
# Workflow separado para rascunho Amazon SP-API (importar criar_anuncio_amazon.json).
N8N_AMAZON_PREPARE_WEBHOOK_URL=https://n8n.odontflow.com.br/webhook/criar_anuncio_amazon
# Alertas Gestão Full → WhatsApp (Evolution API via N8N). Importar n8n/workflows/full_alerts_whatsapp.json
N8N_FULL_ALERTS_WEBHOOK_URL=https://n8n.odontflow.com.br/webhook/full_alerts
# Intervalo do job de alertas Full (ms). Default 1h.
FULL_ALERTS_INTERVAL_MS=3600000
# Intervalo do job de sync de estoque Full (ms). Default 30min; mínimo 5min.
FULL_STOCK_SYNC_INTERVAL_MS=1800000
# Shared secret for N8N → iHub callback POST /api/webhooks/n8n/listing-prepared
# (Authorization: Bearer … or header X-N8N-Secret).
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret
# Public base URL of this deployment (used to build callbackUrl for N8N).
# In Replit, omit to derive from X-Forwarded-* request headers.
# Base pública do iHub (sem path). Também aceita a URL completa do webhook.
IHUB_PUBLIC_URL=https://your-ihub.example.com

# --- Node environment (both) ---
# Set to "production" in production to enable optimised logging and behaviour.
NODE_ENV=development
