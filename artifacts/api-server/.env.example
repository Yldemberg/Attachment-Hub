# ============================================================
# API Server .env.example — copy to .env and fill in real values.
# Variables marked [dev] are only needed in local development.
# Variables marked [prod] are only needed in production.
# Variables marked [both] are required in all environments.
# ============================================================

# --- Database (both) ---
# PostgreSQL connection string used by Drizzle ORM and the connection pool.
# In Replit dev this is auto-provisioned; in prod point to Supabase's
# transaction pooler URL (port 6543) or direct connection (port 5432).
DATABASE_URL=postgresql://user:password@localhost:5432/ihub

# --- Critical ads Supabase database (both) ---
# Supabase connection for ml_diagnostico_critico (separate from iHub core DATABASE_URL).
ML_DIAGNOSTICO_DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Supabase URL (both*) ---
# Supabase project URL used to derive the JWKS endpoint for JWT verification.
# Required when SUPABASE_JWT_SECRET is NOT set (remote JWKS fallback).
SUPABASE_URL=https://your-project.supabase.co

# --- Supabase JWT secret (both*) ---
# HS256 secret found in Supabase > Project Settings > API > JWT Secret.
# When set, tokens are verified locally (faster, no network round-trip).
# If absent, the server falls back to remote JWKS via SUPABASE_URL.
# * At least one of SUPABASE_URL or SUPABASE_JWT_SECRET must be set.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- CORS (prod) ---
# Comma-separated list of allowed origins for cross-origin requests.
# When absent, the server allows all origins (safe for Replit dev).
# In production, set this to your deployed frontend domain(s).
CORS_ALLOWED_ORIGINS=https://ihub.example.com

# --- Mercado Livre OAuth (both) ---
# OAuth 2.0 client ID from Mercado Livre Developer Console.
ML_CLIENT_ID=your-ml-client-id

# --- Mercado Livre OAuth secret (both) ---
# OAuth 2.0 client secret from Mercado Livre Developer Console.
ML_CLIENT_SECRET=your-ml-client-secret

# --- Mercado Livre OAuth redirect URI (both) ---
# Must match the redirect URI registered in Mercado Livre Developer Console.
ML_REDIRECT_URI=https://ihub.example.com/api/mercadolivre/callback

# --- Amazon SP-API (private app — shared across all seller stores) ---
# Same LWA app for every CNPJ/loja. Additional stores connect in UI with their
# own Seller ID + Refresh Token (do not overwrite these for a second store).
AMAZON_LWA_CLIENT_ID=your-amazon-lwa-client-id
AMAZON_LWA_CLIENT_SECRET=your-amazon-lwa-client-secret
# Optional defaults for the first store (or "Usar credenciais do servidor" in UI)
AMAZON_REFRESH_TOKEN=Atzr|your-amazon-refresh-token
AMAZON_SELLER_ID=AXXXXXXXXXXXX
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC

# --- Mercado Livre webhook secret (both) ---
# Secret used to verify the HMAC signature on incoming ML webhook notifications.
ML_WEBHOOK_SECRET=your-ml-webhook-secret

# --- Stripe secret key (both) ---
# Found in Stripe Dashboard > Developers > API Keys > Secret key.
# Use a test key (sk_test_…) in dev and a live key (sk_live_…) in prod.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# --- Stripe webhook secret (both) ---
# Found in Stripe Dashboard > Webhooks > your endpoint > Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# --- Log level (both) ---
# Pino log level: trace | debug | info | warn | error | fatal.
# Defaults to "info" when not set.
LOG_LEVEL=info

# --- N8N listing creation (prepare only) ---
N8N_PREPARE_WEBHOOK_URL=https://n8n.odontflow.com.br/webhook/criar_anuncio
N8N_AMAZON_PREPARE_WEBHOOK_URL=https://n8n.odontflow.com.br/webhook/criar_anuncio_amazon
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret
# Base pública do iHub (sem path). Também aceita a URL completa do webhook.
IHUB_PUBLIC_URL=https://your-ihub.example.com
# Max wait for N8N callback before marking prepare job as failed (ms). Default: 60000 (1 min).
LISTING_PREPARE_JOB_TIMEOUT_MS=60000

# --- Node environment (both) ---
# Set to "production" in production to enable prod-optimised logging and behaviour.
NODE_ENV=development

# --- Server port (dev) ---
# Port the Express server listens on.  In Replit this is injected automatically.
PORT=8080
