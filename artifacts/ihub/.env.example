# ============================================================
# iHub frontend .env.example — copy to .env and fill in real values.
# All VITE_* variables are inlined at build time by Vite.
# Variables marked [dev] are only needed in local development.
# Variables marked [prod] are only needed in production.
# Variables marked [both] are required in all environments.
# ============================================================

# --- API server base URL (prod) ---
# Base URL of the backend API server (no trailing slash).
# Leave empty ("") in Replit dev so requests are proxied by the Vite dev server
# to http://localhost:8080. In production set to your deployed API domain.
VITE_API_URL=https://api.ihub.example.com

# --- Supabase URL (both) ---
# Supabase project URL used by the Supabase JS client for auth and data.
VITE_SUPABASE_URL=https://your-project.supabase.co

# --- Supabase anon key (both) ---
# Public anon key from Supabase > Project Settings > API > Project API Keys.
# Safe to expose in the browser; row-level security enforces access control.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Dev server port (dev) ---
# Port the Vite dev server listens on. Injected automatically by Replit.
PORT=3000

# --- Base path (dev) ---
# URL base path the Vite dev/preview server is mounted at (e.g. "/" or "/ihub").
# Injected automatically by Replit; must match the artifact previewPath.
BASE_PATH=/

# --- CORS (informational) ---
# This variable is consumed by the API server, not the frontend build.
# It is listed here as a cross-reference so deployers know what to set on the backend
# when this frontend is served from a custom domain.
# See artifacts/api-server/.env.example for the full description.
CORS_ALLOWED_ORIGINS=https://ihub.example.com
